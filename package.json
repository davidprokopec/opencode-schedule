{
  "name": "opencode-waits",
  "version": "0.4.0",
  "description": "OpenCode V2 plugin that defers a prompt: /wait 1hour implement this",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidprokopec/opencode-waits.git"
  },
  "homepage": "https://github.com/davidprokopec/opencode-waits#readme",
  "bugs": "https://github.com/davidprokopec/opencode-waits/issues",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "effect",
    "scheduler",
    "delay"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test && bun run build",
    "prepublishOnly": "bun run check",
    "build": "vite build",
    "lint": "biome check src test vite.config.ts",
    "lint:fix": "biome check --write src test vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "@opencode/schema": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "effect": "4.0.1",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@opencode/theme": "2.2.0",
    "@opentui/keymap": "0.7.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.2",
    "typescript": "5.8.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
